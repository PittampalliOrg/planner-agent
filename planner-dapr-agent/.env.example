# Local Development Secrets
# These are accessed via Dapr secretstore (local-secrets component)
# For K8s deployment, secrets come from Azure Key Vault

# OpenAI API key (required for llm-provider component)
OPENAI_API_KEY=your-openai-api-key-here

# Note: Configuration values (PUBSUB_NAME, etc.) are now loaded from
# Dapr Configuration API. See config.json for local development values.
