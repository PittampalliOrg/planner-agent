# Planner Agent Dockerfile - UV-based for faster builds
# Multi-stage build using uv for efficient dependency management
#
# NOTE: The ghcr.io/astral-sh/uv image should be pre-pulled locally for fast builds:
#   docker pull ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# =============================================================================
# Stage 1: Builder - Install dependencies with uv
# =============================================================================
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build

# UV configuration for optimal builds
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Install dependencies first (cached layer)
# Uses cache mount for uv's package cache
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev || uv sync --no-install-project --no-dev

# Copy application code
COPY pyproject.toml /app/
COPY task_manager.py /app/
COPY plan_manager.py /app/
COPY planner_agent.py /app/
COPY workflow_service.py /app/
COPY streaming.py /app/
COPY main.py /app/
COPY durable_agent.py /app/

# Final sync with project installed
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-editable --no-dev || uv sync --no-editable --no-dev

# =============================================================================
# Stage 2: Runtime - Lean production image
# =============================================================================
FROM python:3.12-slim-bookworm AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security (Kubernetes best practice)
RUN groupadd --gid 1000 planner && \
    useradd --uid 1000 --gid planner --shell /bin/bash --create-home planner

# Copy the entire app with virtual environment from builder
COPY --from=build --chown=planner:planner /app /app

# Set up virtual environment path
ENV PATH="/app/.venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Create directories for plans and workspace
RUN mkdir -p /app/plans /app/workspace && \
    chown -R planner:planner /app

# Switch to non-root user
USER planner

# Environment variables
# ANTHROPIC_API_KEY must be provided at runtime (via Kubernetes Secret)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/planner

# Default working directory for the agent (can be overridden)
ENV PLANNER_CWD=/app/workspace \
    PLANNER_PLANS_DIR=/app/plans

# Health check - verify FastAPI health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose FastAPI port
EXPOSE 8080

# Default entrypoint - run FastAPI workflow service
ENTRYPOINT ["/app/.venv/bin/uvicorn", "workflow_service:app", "--host", "0.0.0.0", "--port", "8080"]

# Default command (no additional args needed)
CMD []
